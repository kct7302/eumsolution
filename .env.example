APP_ENV=local
# HTML 전환 후 회사 정보는 각 .html 파일에서 수정합니다.
# 아래 SITE_* 값은 이전 PHP 화면의 호환용 예시입니다.
SITE_NAME=EUM Solution
SITE_COMPANY=주식회사 이음솔루션
SITE_CEO=대표자명
SITE_PHONE=000-0000-0000
SITE_EMAIL=contact@example.com
SITE_ADDRESS=회사 주소를 입력해 주세요
SITE_DESCRIPTION=정책자금·기업인증·재무전략을 연결하는 기업 컨설팅

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=eumsolution
DB_USER=eum_app
DB_PASSWORD=replace_with_your_mariadb_password
DB_CHARSET=utf8mb4
